# Copy to .env next to docker-compose.yml (or paste into Portainer's stack environment).
# See README.md, section 5, for what each variable does.

# ---- Identity / host ----
PUID=1000
PGID=1000
TZ=Europe/Madrid
HOST_IP=192.168.1.10            # LAN IP of the Docker host (dashboard links only)

# ---- Storage (host paths) ----
BASE_PATH=/srv/appdata         # app configs (SSD/NVMe)
FAST_MOUNT=/srv/fast                    # Plex config/transcode, FileFlows temp, Subgen scratch
MEDIA_SHARE=/srv/pool/media             # the library: tv/ movies/ youtube/ cine/ music/ audiobooks/ podcasts/ system/
DOWNLOAD_DIR=/srv/pool/downloads        # qBittorrent completed downloads (complete/tv, complete/movies)
INCOMPLETE_DOWNLOAD_DIR=/mnt/incomplete # qBittorrent in-progress downloads
CONFIG_DIR=/srv/appdata        # Gluetun state dir (defaults to ./config if unset)

# ---- VPN (Gluetun + Mullvad WireGuard) ----
WIREGUARD_PRIVATE_KEY=                  # PrivateKey from the Mullvad WireGuard .conf
WIREGUARD_ADDRESSES=10.0.0.0/32         # Address from the same .conf, keep the /32
SERVER_COUNTRIES=Netherlands,Switzerland,Sweden

# ---- Plex ----
PLEX_CLAIM=claim-xxxxxxxxxxxxxxxxxxxx   # https://plex.tv/claim, valid 4 minutes, first start only

# ---- Filled in after first configuration (README section 7, step 4) ----
SONARR_KEY=
RADARR_KEY=
QBITTORRENT_USERNAME=admin
QBIT_PASS=

# ---- Optional: host ports (defaults shown) ----
#QBIT_PORT=8080
#PROWLARR_PORT=9696
#SONARR_PORT=8989
#RADARR_PORT=7878
#BAZARR_PORT=6767
#OVERSEERR_PORT=5055
#TAUTULLI_PORT=8181
#WIZARR_PORT=5690
#JELLYFIN_PORT=8096
#FILEFLOWS_PORT=19200
#MAINTAINERR_PORT=6246
#MAINTAINERR_API_PORT=3001
#FLARESOLVERR_PORT=8191
#WATCHTOWER_PORT=8081
#UNPACKERR_PORT=5656
#FLAME_PORT=1313

# ---- Optional: misc ----
#FLAME_PASSWORD=flame
#WATCHTOWER_SCHEDULE=0 3 0 * * 6        # 6-field cron with seconds: Saturdays 00:03
#WATCHTOWER_NOTIFICATION_URL=ntfy://ntfy.sh/your-topic
